# SQLite is the default. No database server or credentials are required.
# The current installation stores its database at instance/rpms.db.
# DATABASE_URL overrides private instance/database.json settings.
# Optional absolute-path override:
# DATABASE_URL=sqlite:////absolute/path/to/instance/rpms.db
# SECRET_KEY=replace-with-a-random-secret

# Deployment mode; production requires SECRET_KEY and HTTPS.
# RPMS_ENV=production
# Configure these in your host or export them; .env is not loaded automatically.
